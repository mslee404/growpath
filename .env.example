APP_NAME=GrowPath
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Lokal paling mudah pakai SQLite (buat file database/database.sqlite).
# Production (Render + Neon): DB_CONNECTION=pgsql dan DB_URL=postgresql://...?sslmode=require
DB_CONNECTION=sqlite
# DB_URL=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# Midtrans Sandbox (dashboard.midtrans.com -> Settings -> Access Keys).
# Kosongkan = fitur top-up gold nonaktif.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_PRODUCTION=false

VITE_APP_NAME="${APP_NAME}"
